# Patterns without a slash match at every level; slashed ones are anchored here.

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
# apps/editor's visual-test build, kept apart from the deployable `dist/`.
dist-test
*.local
# packages/ui's Storybook build.
storybook-static

# Caches
.turbo
.cache
*.tsbuildinfo

# Reserved prefix for scratch output, so it stays out of eslint and prettier runs.
# Mirrored in packages/cli's eslint globalIgnores and .prettierignore.
.scratch*

# env files (can opt-in for committing if needed)
.env*
# ...but templates are committed.
!.env.example
# ...and apps/editor/.env.production: public, frozen into the bundle, and what
# check-deployable-bundle.ts checks against.
!.env.production
# ...and apps/editor/.env.test, the stub worker's address.
!.env.test

# Wrangler's local secrets; `.env*` does not match `.dev.vars`.
.dev.vars
.dev.vars.*
# ...except the template, which lists names only.
!.dev.vars.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Claude Code working files, at any level
.claude
# An installation's source, `.agents-inc/<provider>/`.
.agents-inc
.claude-design/
CLAUDE.md

# Playwright. `test-results/` is unanchored because a run from the root writes it there.
test-results/
apps/editor/test-results/
apps/editor/playwright-report/
apps/editor/blob-report/
apps/editor/.playwright/
# Argos captures from `test:visual`.
apps/editor/screenshots/

# wrangler local state
.wrangler

# The CLI's private notes, all but two.
packages/cli/todo/*
!packages/cli/todo/TODO.md
!packages/cli/todo/TODO-completed.md

# Tracked CLAUDE.md files the unanchored rule above would swallow. A new workspace
# CLAUDE.md needs a line here, or it never leaves the machine it was written on.
!/CLAUDE.md
!packages/cli/CLAUDE.md
!packages/cli/src/cli/lib/__tests__/fixtures/stacks/default/CLAUDE.md
!packages/ui/CLAUDE.md

# The Skill Olympics corpus stays local: third-party skill text and benchmark outputs.
todo/plans/CLI-729-skill-olympics/

# Bundle written by packages/cli/scripts/handrun.mjs beside the e2e helpers.
packages/cli/e2e/helpers/handrun.gen.mjs

# StrykerJS (mutation testing)
.stryker-tmp/
/reports/
