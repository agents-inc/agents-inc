// The SPA host. There is deliberately no `main`: a Worker serving only static
// assets needs no script, and asset requests are then unmetered — the UI costs
// nothing against the request budget, only the API does.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The deployed Cloudflare Worker's service name — not a path, not the
  // workspace name. It must match a Worker that already exists, because a
  // deploy naming a Worker that does not exist CREATES one: the site would
  // then be published to a new Worker while the custom domain below stayed
  // with the old one, and the live apex would silently stop updating.
  //
  // Renamed in the Cloudflare dashboard on 2026-08-06, `agents-inc-web` →
  // `agents-inc-editor`, which is an in-place rename — the deployment history
  // and the custom domain travel with the Worker, and no second Worker is
  // created. This line was updated to agree immediately afterwards, which is
  // the required order: the dashboard first, then here.
  "name": "agents-inc-editor",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // TanStack Router owns every path below the root, so an unmatched request
    // is a client-side route rather than a 404 — without this, a hard refresh
    // on anything but `/` fails.
    "not_found_handling": "single-page-application",
  },
  // A ROUTE ON A PATH, not the apex. The apex is a Custom Domain on
  // `agents-inc-www` (the landing page and `/docs`); this Worker owns
  // `/editor*` beneath it. Cloudflare documents the combination: a Route and a
  // Custom Domain coexist on one hostname and the Route takes precedence, with
  // the more specific pattern winning between two Routes.
  //
  // WRITTEN `/editor*` AND NOT `/editor/*`. Cloudflare's own Known Issues page
  // records that `/editor/*` does not match `/editor` itself, so the bare path
  // would fall through to the apex Worker and 404 on the site's own 404 page.
  //
  // THE STRING FORM IS NOT A STYLE CHOICE. `wrangler/config-schema.json` gives
  // `Route` as `anyOf[string, ZoneIdRoute, ZoneNameRoute, CustomDomainRoute]`,
  // and all three object forms are `additionalProperties: false` with a
  // required discriminator — so a bare `{ "pattern": "…" }` matches none of
  // them and fails config validation at deploy time.
  //
  // A route-mounted assets Worker TERMINATES the request: it does not fall
  // through to the apex Worker when an asset is missing, so this Worker owns
  // every 404 beneath `/editor`.
  "routes": ["agentsinc.sh/editor*"],
}
