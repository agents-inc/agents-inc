// Static assets only, so no `main`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Must match the existing Worker: a new name creates a new one.
  "name": "agents-inc-editor",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // The router owns every path; without this a hard refresh off `/` 404s.
    "not_found_handling": "single-page-application",
  },
  // `/editor*`, not `/editor/*`, which does not match `/editor` itself. String
  // form: a bare `{ pattern }` object fails config validation.
  "routes": ["agentsinc.sh/editor*"],
}
