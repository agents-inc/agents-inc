{
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "moduleResolution": "bundler",
    // The same aliases the app's own project declares. A Playwright spec runs
    // in NODE, so it can reach the app's pure modules directly — which is what
    // lets `output-preview.spec.ts` hold the rendered pane against the model
    // that produced it rather than against a string typed into the spec.
    // Playwright resolves these itself from the solution tsconfig; `tsc` reads
    // only the project it is checking, so they have to be here too.
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"],
      "@workspace/matrix": ["../../packages/matrix/src/index.ts"],
      "@workspace/matrix/*": ["../../packages/matrix/src/*"]
    }
  },
  "include": ["e2e", "playwright.config.ts", "playwright.visual.config.ts"]
}
