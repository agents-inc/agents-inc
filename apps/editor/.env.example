# Optional: `bun dev` and `bun run build` work with no `.env`. Production values
# live in `.env.production`, which outranks this file in production mode.
# Every variable is validated by `src/env.schema.ts` at build time.

# Dev only, to reach a worker on another port; defaults to localhost:8787.
# VITE_API_URL=http://localhost:8787

# Error reporting. Absent means Sentry is never initialised.
# VITE_SENTRY_DSN=

# Build-time only, never in the bundle: all three upload source maps, which the
# build then deletes from `dist/`. Absent means no source maps at all.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Product analytics. Absent means the PostHog SDK is never downloaded.
# VITE_POSTHOG_KEY=
# The schema defaults to US; an EU project uses https://eu.i.posthog.com.
# VITE_POSTHOG_HOST=https://us.i.posthog.com
