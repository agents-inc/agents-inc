{
  "name": "editor",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "//deploy": "The check is not optional and not a lint. `turbo deploy` runs `build` first (root turbo.json), and VITE_API_URL is frozen into that build — so this is the only moment anything can still tell whether the bundle wrangler is about to upload talks to the production API or to somebody's laptop. It reads dist/, not the environment. See the header of scripts/check-deployable-bundle.ts.",
    "deploy": "bun scripts/check-deployable-bundle.ts && wrangler deploy",
    "generate:icons": "bun scripts/generate-skill-icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sentry/react": "^10.69.0",
    "@tanstack/react-router": "^1.170.18",
    "@workspace/matrix": "workspace:*",
    "@workspace/ui": "workspace:*",
    "hono": "^4.11.4",
    "posthog-js": "^1.409.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "simple-icons": "^16.27.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@workspace/api-mocks": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "^10",
    "server": "workspace:*",
    "typescript": "~6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "^4"
  }
}
