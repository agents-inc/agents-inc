{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // preview-matches-install.spec.ts runs the CLI, which `^build` does not
    // reach.
    "test:e2e": {
      "dependsOn": ["^build", "agents-inc#build"],
      "cache": false,
      "passThroughEnv": ["EDITOR_E2E_PORT"]
    }
  }
}
