// Stores seed payloads in KV under content-addressed ids and serves the skill
// index from the same namespace. Only the build-skill-index workflow writes the
// index key, reading the namespace id from here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-inc-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // better-auth needs `node:crypto`; without this the worker does not boot,
  // though the vitest pool tolerates it.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "kv_namespaces": [
    { "binding": "CONFIGS", "id": "6a69c245741c40c9b6a1f3d22935b7d2" },
  ],
  // CONFIG_WRITES caps the unauthenticated `POST /configs` per address.
  // `period` accepts only 10 or 60; src/index.ts restates it as Retry-After.
  "ratelimits": [
    {
      "name": "CONFIG_WRITES",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // Per user: compose is signed-in only and billed per person.
    {
      "name": "COMPOSE_CALLS",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "agents-inc-db",
      "database_id": "7e0a4407-89d0-4d24-893f-2fe0b70fa890",
    },
  ],
  "vars": {
    // The browser origin allowed by CORS; this block is the local value.
    "WEB_ORIGIN": "http://localhost:5173",
    // Public (it is in the OAuth URL); one GitHub app per callback URL. This is
    // "agents Inc local". The secret lives in .dev.vars.
    "GITHUB_CLIENT_ID": "Ov23liHANitAG2b0NDXj",
    // Not derivable from WEB_ORIGIN; Better Auth needs it for the callback.
    "AUTH_BASE_URL": "http://localhost:8787",
    // The one Sentry project `/monitoring` relays to.
    "SENTRY_INGEST_HOST": "o4509197991346176.ingest.de.sentry.io",
    "SENTRY_PROJECT_ID": "4511832531796048",
  },
  "env": {
    // Deploys pass `--env production`. Bindings and vars do not inherit into a
    // named environment, so each is restated below.
    "production": {
      "name": "agents-inc-api",
      "compatibility_flags": ["nodejs_compat"],
      "routes": [{ "pattern": "api.agentsinc.sh", "custom_domain": true }],
      "observability": { "enabled": true },
      "upload_source_maps": true,
      "kv_namespaces": [
        { "binding": "CONFIGS", "id": "6a69c245741c40c9b6a1f3d22935b7d2" },
      ],
      "ratelimits": [
        {
          "name": "CONFIG_WRITES",
          "namespace_id": "1001",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "COMPOSE_CALLS",
          "namespace_id": "1002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "agents-inc-db",
          "database_id": "7e0a4407-89d0-4d24-893f-2fe0b70fa890",
        },
      ],
      "vars": {
        "WEB_ORIGIN": "https://agentsinc.sh",
        // "agents Inc prod".
        "GITHUB_CLIENT_ID": "Ov23liy1WGblcNBDJoXc",
        "AUTH_BASE_URL": "https://api.agentsinc.sh",
        "SENTRY_INGEST_HOST": "o4509197991346176.ingest.de.sentry.io",
        "SENTRY_PROJECT_ID": "4511832531796048",
      },
    },
  },
}
