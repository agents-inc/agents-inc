# Copy to `.dev.vars` (gitignored; read only by `wrangler dev`). Production
# values are Worker secrets set with `wrangler secret put --env production`.

# The "agents Inc local" GitHub OAuth app's client secret.
GITHUB_CLIENT_SECRET=

# Any 32+ random characters (`openssl rand -base64 32`); not production's.
BETTER_AUTH_SECRET=

# The composer's Anthropic key.
ANTHROPIC_API_KEY=

# Optional Cloudflare AI Gateway URL; empty talks to Anthropic directly. Not a
# wrangler.jsonc var: `wrangler types` would type an empty var as `""`.
AI_GATEWAY_URL=
