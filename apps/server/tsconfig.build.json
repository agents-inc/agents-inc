{
  // Emits `AppType` declarations for apps/editor, which cannot load the Workers
  // runtime types. wrangler builds the worker itself.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  // The entry alone, so test files get no declarations.
  "include": ["src/index.ts", "worker-configuration.d.ts"]
}
