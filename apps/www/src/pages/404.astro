---
/** Hand-built: Starlight's 404 route is disabled in astro.config.ts. Placeholder copy. */
import "../styles/site.css"
import FontPreloads from "../components/font-preloads.astro"
import SiteHeader from "../components/site-header.astro"

import { DOCS_PATH, HOME_PATH } from "../lib/links"

const PAGE_TITLE = "Page not found | Agents Inc"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{PAGE_TITLE}</title>
    <meta name="robots" content="noindex" />
    <FontPreloads />
  </head>
  <!-- No colour classes on <body>: globals.css already styles it in @layer base. -->
  <body class="framed">
    <SiteHeader />

    <main class="mx-auto max-w-page px-8 pt-gutter pb-gutter sm:px-gutter">
      <h1 class="text-h1 text-ink max-w-measure font-semibold">Page not found</h1>
      <p class="text-body text-ink-3 mt-4 max-w-measure">
        That page does not exist. It may have moved, or the link that sent you here may be
        out of date.
      </p>
      <p class="text-body mt-4">
        <a href={HOME_PATH}>Home</a> &middot; <a href={DOCS_PATH}>Documentation</a>
      </p>
    </main>
  </body>
</html>
