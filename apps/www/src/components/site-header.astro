---
/** The 404's header. Classes mirror the editor's NavRail. */
import {
  DOCS_PATH,
  EDITOR_URL,
  EXTERNAL_LINK_ATTRS,
  GITHUB_REPO_URL,
  SKILLS_REPO_URL,
} from "../lib/links"

// NavRail's class minus active-state variants: no link here points at itself.
const NAV_LINK_CLASS =
  "font-mono text-11 font-medium tracking-[.07em] whitespace-nowrap uppercase text-muted-foreground hover:text-ink"
---

{/* The 60px gutter is a desktop constant; phones get px-8. */}
<header class="mx-auto flex max-w-page items-center gap-4 px-8 pt-10 sm:px-gutter">
  <a href={EDITOR_URL} class="flex items-center gap-[0.6875rem]" aria-label="Agents Inc, home">
    <span
      class="flex size-[2.375rem] shrink-0 items-center justify-center border border-brand font-mono text-12 font-semibold tracking-[.02em] text-brand-ink"
      aria-hidden="true">a-i</span
    >
    {/* Mark only below `sm`; the aria-label is unchanged. */}
    <span class="hidden font-mono text-11 font-medium tracking-[.07em] text-ink uppercase sm:inline"
      >Agents Inc</span
    >
  </a>

  <nav class="ml-auto flex items-center gap-[1.125rem]" aria-label="Main">
    <a href={EDITOR_URL} class={NAV_LINK_CLASS}>Editor</a>
    <a href={DOCS_PATH} class={NAV_LINK_CLASS}>Docs</a>
    <a href={SKILLS_REPO_URL} {...EXTERNAL_LINK_ATTRS} class={NAV_LINK_CLASS}>Skills</a>
    <a href={GITHUB_REPO_URL} {...EXTERNAL_LINK_ATTRS} class={NAV_LINK_CLASS}>GitHub</a>
  </nav>
</header>
