---
/**
 * Starlight's head with font preloads first. A component rather than the
 * `head:` config, because only an import resolves Vite's hashed URLs.
 */
import Default from "@astrojs/starlight/components/Head.astro"

import FontPreloads from "./font-preloads.astro"
---

<FontPreloads />
<Default {...Astro.props}><slot /></Default>
