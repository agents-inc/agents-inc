---
/**
 * Preloads the latin subsets the first screen paints with, so the narrower
 * fallback never reflows the page. Imported because Vite content-hashes the
 * URLs. `crossorigin` is required: fonts fetch in CORS mode, else they download twice.
 */
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url"
import plexLatin400 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url"
import plexLatin500 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url"
import plexLatin600 from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url"

const PRELOADED = [interLatin, plexLatin400, plexLatin500, plexLatin600]
---

{
  PRELOADED.map((href) => (
    <link rel="preload" as="font" type="font/woff2" href={href} crossorigin />
  ))
}
