// No `main`: a static-assets-only Worker needs no script.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-inc-www",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Astro emits a file per route plus `404.html`, unlike the editor SPA.
    "not_found_handling": "404-page",
  },

  // The apex. The editor's Worker holds the more specific `agentsinc.sh/editor*`
  // route. Moving the Custom Domain onto this Worker is a dashboard step.
  "routes": [{ "pattern": "agentsinc.sh", "custom_domain": true }],
}
