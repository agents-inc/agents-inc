// The documentation site: the landing page at `/` and Starlight at `/docs`.
// Like the editor's Worker there is deliberately no `main` — a Worker serving
// only static assets needs no script, and asset requests are then unmetered.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agents-inc-www",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./dist",
    // Astro emits a real file per route plus `404.html`, so an unmatched
    // request is a genuine miss rather than a client-side route — the opposite
    // of the editor, which is a single-page app and rewrites everything to
    // `index.html`.
    "not_found_handling": "404-page",
  },

  // THE APEX, as a Custom Domain. It was deliberately absent while this build
  // was unreachable by name: `agentsinc.sh` was a Custom Domain on the editor's
  // Worker, and a hostname binds to one Worker at a time, so claiming it here
  // would have taken the live site away from the editor the moment it deployed.
  //
  // That is what the split resolved. This Worker now catches everything
  // unclaimed on the hostname — `/` the landing page, `/docs` Starlight — while
  // `agents-inc-editor` holds the Route `agentsinc.sh/editor*`, which takes
  // precedence beneath it.
  //
  // THE MOVE IS A DASHBOARD STEP, NOT THIS LINE. Deploying this while the apex
  // is still bound to the editor's Worker does not reassign it. The Custom
  // Domain has to be moved onto this Worker in the Cloudflare dashboard, and
  // `wrangler deploy` in CI is non-interactive, so a claim that needs
  // confirmation fails there rather than doing the right thing quietly.
  "routes": [{ "pattern": "agentsinc.sh", "custom_domain": true }],
}
