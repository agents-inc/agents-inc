# Cloudflare otherwise sends `max-age=0, must-revalidate`, so every navigation
# revalidated the webfonts and reflowed on the fallback. Held by
# scripts/check-webfont-delivery.ts.

# Content-hashed filenames, so the bytes behind a URL never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML deliberately keeps the revalidating default so a deploy shows on the next click.
