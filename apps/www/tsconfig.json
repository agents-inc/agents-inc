{
  "$schema": "https://json.schemastore.org/tsconfig",

  // Later entries win, so Astro owns what it must.
  "extends": [
    "@workspace/typescript-config/base.json",
    "astro/tsconfigs/strict"
  ],
  "compilerOptions": {
    // DOM for theme-provider.astro's inline script.
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": [".astro/types.d.ts", "**/*"],
  // Astro's preset turns on allowJs; the ESLint config's deps ship no types.
  "exclude": ["dist", "eslint.config.js"]
}
