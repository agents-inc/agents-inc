{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // `build`, not `^build`: the checks read this workspace's own dist/.
    "test": {
      "dependsOn": ["build"],
      // Two checks read CLI source this site does not depend on, so turbo
      // must be told or a CLI-only change replays from cache.
      // `$TURBO_DEFAULT$` stays because naming inputs replaces the default set.
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../packages/cli/src/cli/commands/**",
        "../../packages/cli/src/cli/consts.ts"
      ]
    }
  }
}
