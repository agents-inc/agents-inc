{
  "$schema": "./node_modules/knip/schema-jsonc.json",
  "workspaces": {
    ".": {
      // Exists only to throw; nothing imports it.
      "entry": ["vitest.config.mjs"],
      // ESLint is hoisted from the workspaces, which each declare it.
      "ignoreBinaries": ["eslint"],
    },
    "packages/api": {
      // The vitest include is re-exported one hop from the config knip reads.
      "entry": ["src/**/*.test.ts"],
    },
    "packages/api-mocks": {
      // The vitest include is re-exported one hop from the config knip reads.
      "entry": ["src/**/*.test.ts"],
    },
    "packages/cli": {
      "entry": [
        // Loaded by oclif convention; knip's oclif plugin expects {,src/}commands/**.
        "src/cli/commands/**/*.{ts,tsx}",
        "src/cli/hooks/**/*.ts",
        // Spawned by the E2E specs by path.
        "bin/*.js",
        // knip resolves globalSetup from the config's directory, vitest from the root.
        "e2e/global-setup.ts",
      ],
      "ignore": ["src/cli/types/generated/**"],
      "ignoreUnresolved": ["./e2e/global-setup.ts"],
    },
    "packages/compile": {
      // The vitest include is re-exported one hop from the config knip reads.
      "entry": ["src/**/*.test.ts"],
    },
    "packages/matrix": {
      // The vitest include is re-exported one hop from the config knip reads.
      "entry": ["src/**/*.test.ts"],
      // Vendored by packages/cli's generate:matrix.
      "ignore": ["src/vendor/**"],
    },
    "packages/ui": {
      // Stories are one hop past knip's storybook plugin; terrazzo.config.js is read by `tz`.
      "entry": ["src/**/*.stories.tsx", "terrazzo.config.js"],
    },
    "apps/editor": {
      // Off: evaluating the config validates the environment and can throw.
      "vite": false,
      // Named so its plugin imports still count.
      "entry": ["vite.config.ts"],
    },
    "apps/server": {
      "entry": ["scripts/*.ts"],
      // `cloudflare:test` is a virtual module, not a package.
      "ignoreDependencies": ["cloudflare"],
    },
  },
}
