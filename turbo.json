{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // Inlined into the bundle, so part of the build's hash (values are hashed, not stored).
      "env": [
        "VITE_API_URL",
        "VITE_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST"
      ],
      "outputs": ["dist/**"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      // Credentials reach wrangler without entering any hash.
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    // `^build`: apps/editor types its API client from a declaration apps/server emits.
    "lint": {
      "dependsOn": ["^lint", "^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    // apps/server: fails when a schema change lacks its migration.
    "db:generate:check": {
      "cache": false
    }
  }
}
