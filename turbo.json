{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      // These are inlined into the bundle or decide what it contains, so they
      // are part of the build's identity — without them here, a cached build
      // from another environment would be replayed with the wrong API baked
      // in, or with source maps silently not uploaded. turbo hashes the
      // values rather than storing them, so a token is safe to name.
      "env": [
        "VITE_API_URL",
        "VITE_SENTRY_DSN",
        "SENTRY_AUTH_TOKEN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VITE_POSTHOG_KEY",
        "VITE_POSTHOG_HOST"
      ],
      "outputs": ["dist/**"]
    },
    "deploy": {
      "dependsOn": ["build"],
      "cache": false,
      // turbo runs tasks in a sanitized environment (envMode: strict), so
      // wrangler sees nothing that is not named here. `passThroughEnv` rather
      // than `env` because these are credentials: they must reach the task
      // without becoming part of any hash.
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    // `^build` is right for the editor: its Playwright config starts a Vite
    // dev server, so only the packages it depends on need building first. The
    // CLI is different — its suite drives its own built dist/index.js — so it
    // adds `build` to this list in packages/cli/turbo.json rather than
    // widening the rule for everyone.
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": false
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
