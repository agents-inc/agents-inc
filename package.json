{
  "name": "@agents-inc/cli",
  "version": "0.149.0",
  "description": "CLI for managing Agents Inc. skills, stacks, and agents for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./config": {
      "import": "./dist/config-exports.js"
    }
  },
  "bin": {
    "agents-inc": "dist/index.js",
    "agentsinc": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "config/",
    "src/agents/",
    "src/schemas/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "claude",
    "claude-code",
    "skills",
    "composable skills",
    "agents",
    "stacks",
    "plugins",
    "ai",
    "anthropic",
    "developer-tools",
    "productivity",
    "prompt-engineering",
    "ai-tools"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "oclif": {
    "bin": "agents-inc",
    "dirname": "agents-inc",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "hooks": {
      "init": [
        "./dist/hooks/init"
      ]
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "agentsinc": "node dist/index.js",
    "agentsinc:dev": "bun src/cli/index.ts",
    "test": "vitest run",
    "pretest:e2e": "npm run build",
    "test:e2e": "vitest --config e2e/vitest.config.ts --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && echo '✓ No TypeScript errors'",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "prepare": "husky",
    "generate:types": "bun scripts/generate-source-types.ts",
    "generate:schemas": "npx tsx scripts/generate-json-schemas.ts",
    "generate:schemas:check": "npm run generate:schemas && git diff --exit-code src/schemas/",
    "prepublishOnly": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test"
  },
  "lint-staged": {
    "*.{ts,js,json,yaml,yml,md}": "prettier --write",
    "*.{ts,tsx}": "eslint --no-warn-ignored"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-inc/cli.git"
  },
  "author": "Vincent Bollaert",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agents-inc/cli/issues"
  },
  "homepage": "https://github.com/agents-inc/cli#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-autocomplete": "^3.0.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-not-found": "^3.0.0",
    "@oclif/plugin-warn-if-update-available": "^3.0.0",
    "@oclif/table": "^0.5.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.0",
    "fs-extra": "^11.2.0",
    "giget": "^1.2.0",
    "gray-matter": "^4.0.3",
    "ink": "^5.0.0",
    "jiti": "2.4.2",
    "liquidjs": "^10.24.0",
    "react": "^18.2.0",
    "remeda": "^2.33.6",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@oclif/test": "^4.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@xterm/headless": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "tree-kill": "^1.2.2",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
