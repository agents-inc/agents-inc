{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // Hash only what tsup consumes; src/agents/ stays in because onSuccess copies it.
    // packages/matrix is covered by the dependency edge, not by these inputs.
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.ai-docs/**",
        "!changelogs/**",
        "!e2e/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!*.md"
      ]
    },
    // `build`, not `^build`: oclif resolves commands from this package's own dist/.
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    // The commands suites also load dist/. The extra inputs are the files specs read
    // outside this package, so a change to one alone invalidates the cached run;
    // scripts/test-task-hashes-the-files-its-specs-read.test.ts holds the list.
    // Unhashed: the findings-frontmatter check's scan of the whole repository.
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../todo/**",
        "../../CLAUDE.md",
        "../../README.md",
        "../../package.json",
        "../../docs/**",
        "../../.husky/*",
        "../../.github/**",
        "../../apps/*/package.json",
        "../../apps/*/tsconfig*.json",
        "../../apps/*/vitest.config.*",
        "../../apps/*/eslint.config.*",
        "../../packages/*/package.json",
        "../../packages/*/tsconfig*.json",
        "../../packages/*/vitest.config.*",
        "../../packages/*/eslint.config.*"
      ]
    }
  }
}
