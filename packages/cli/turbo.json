{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // The default input set is every file in the package, and this package is
    // mostly files the build never reads: reference docs, changelogs, the e2e
    // suite, and the tests that sit beside the code they cover. Editing one
    // line of prose was rebuilding dist. The negations keep the hash to what
    // tsup actually consumes — src/agents/ stays IN because onSuccess copies
    // it into dist verbatim, so its markdown genuinely is build input.
    //
    // What looks missing here and is not: packages/matrix. tsup inlines that
    // package into the bundle (noExternal), so its source is build input as
    // surely as src/ is — and it has no `build` script, so there is seemingly
    // nothing for `^build` to hang on. Its files are in this hash anyway.
    // turbo puts a task node in the graph for a dependency that does not
    // implement the task: `turbo run build --dry=json --filter=agents-inc`
    // shows `@workspace/matrix#build` with `"command": "<NONEXISTENT>"`, all 35
    // of its files hashed, listed among `agents-inc#build`'s dependencies — and
    // that node's hash feeds this one. Measured on turbo 2.10.8, because the
    // opposite was assumed and filed as a bug (CLI-458): appending one comment
    // line to packages/matrix/src/read-model/domains.ts turns a >>> FULL TURBO
    // replay of this task into a re-run, and moves `agents-inc#test`'s hash
    // with it. Editing a package the CLI does NOT depend on (packages/ui)
    // leaves both hashes byte-identical, so it is the dependency edge doing
    // this rather than the global hash. `"../matrix/src/**"` in the inputs
    // above is accepted by turbo and does hash the 23 files it matches, but it
    // would hash them a second time under a second name and would need another
    // line for every workspace dependency this package ever gains.
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "!.ai-docs/**",
        "!changelogs/**",
        "!e2e/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/__mocks__/**",
        "!*.md"
      ]
    },
    // Deliberately `build`, NOT `^build` — do not "fix" the missing caret.
    // The root declares test:e2e as `^build`, meaning "build my dependencies",
    // which is right for the editor: its Playwright config boots a dev server
    // and never reads its own dist. The CLI's e2e suite is the opposite. It
    // spawns bin/run.js under node through a pseudo-terminal, and oclif
    // resolves commands from ./dist/commands, so the suite fails outright
    // unless THIS package has been built. Without the caret, turbo builds this
    // package (and, via the root build's own ^build, its dependencies too).
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    // Same reason, and it is easy to miss because it only bites on a clean
    // checkout. The `commands` suites drive oclif in-process rather than
    // spawning it, so they look like ordinary unit tests — but oclif still
    // resolves command modules from ./dist/commands, and dist is gitignored.
    // Locally a stale dist makes them pass; in CI 205 tests across 17 files
    // failed with exit 127 the first time this ran on a fresh clone.
    "test": {
      "dependsOn": ["build"]
    }
  }
}
