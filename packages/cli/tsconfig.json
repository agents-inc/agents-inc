{
  "$schema": "https://json.schemastore.org/tsconfig",

  // node.json pins `lib` to ES2023 with no DOM globals.
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  // Tool configs are included here, not in a separately named tsconfig, because
  // typescript-eslint's project service only discovers files named tsconfig.json.
  "include": [
    "src/**/*",
    "tsup.config.ts",
    "vitest.config.ts",
    "vitest.global-setup.ts",
    "vitest.setup.ts"
  ]
}
