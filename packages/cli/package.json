{
  "name": "agents-inc",
  "version": "0.175.0",
  "description": "CLI for managing Agents Inc. skills, stacks, and agents for Claude Code",
  "//generate": "Runs all four generators in dependency order; the :check variants stay separate because CI runs different subsets.",
  "//no-shared-vitest-config": "A three-project suite with globals on and its own setup and timeouts; the shared single-project, globals-off config would contradict it.",
  "//test:smoke": "Runs e2e *.smoke.test.ts; the Claude probes skip without the binary, the Codex probe runs for real.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./config": {
      "import": "./dist/config-exports.js"
    }
  },
  "bin": {
    "agents-inc": "dist/index.js",
    "agentsinc": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "src/agents/",
    "src/schemas/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "claude",
    "claude-code",
    "skills",
    "composable skills",
    "agents",
    "stacks",
    "plugins",
    "ai",
    "anthropic",
    "developer-tools",
    "productivity",
    "prompt-engineering",
    "ai-tools"
  ],
  "//sideEffects": "compile-seat.ts is imported bare for its side effect, which plain false would let esbuild drop.",
  "sideEffects": [
    "./src/cli/lib/compile-seat.ts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "oclif": {
    "bin": "agents-inc",
    "dirname": "agents-inc",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "hooks": {
      "init": [
        "./dist/hooks/init"
      ]
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "agentsinc": "node dist/index.js",
    "agentsinc:dev": "bun src/cli/index.ts",
    "//test": "No pretest hook: turbo already builds before test, and a second build races tsup on dist/.",
    "test": "vitest run",
    "test:e2e": "vitest --config e2e/vitest.config.ts --run --project e2e",
    "test:smoke": "vitest --config e2e/vitest.config.ts --run --project smoke",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && echo '✓ No TypeScript errors'",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "generate": "bun run generate:types && bun run generate:schemas && bun run generate:matrix && bun run generate:compile",
    "generate:types": "bun scripts/run-generate-source-types.ts",
    "generate:types:check": "bun scripts/run-generate-source-types.ts --check",
    "generate:schemas": "bun scripts/run-generate-json-schemas.ts",
    "generate:schemas:check": "bun scripts/run-generate-json-schemas.ts --check",
    "generate:matrix": "bun scripts/run-generate-matrix-package.ts",
    "generate:matrix:check": "bun scripts/run-generate-matrix-package.ts --check",
    "generate:compile": "bun scripts/run-generate-compile-package.ts",
    "generate:compile:check": "bun scripts/run-generate-compile-package.ts --check",
    "prepublishOnly": "bun run format:check && bun run lint && bun run typecheck && bun run generate:schemas:check && bun run generate:types:check && bun run build && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-inc/agents-inc.git",
    "directory": "packages/cli"
  },
  "author": "Vincent Bollaert",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agents-inc/agents-inc/issues"
  },
  "homepage": "https://github.com/agents-inc/agents-inc#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-autocomplete": "^3.0.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-not-found": "^3.0.0",
    "@oclif/plugin-warn-if-update-available": "^3.0.0",
    "@oclif/table": "^0.5.0",
    "chalk": "^5.6.2",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.0",
    "fs-extra": "^11.2.0",
    "giget": "^1.2.0",
    "ink": "^7",
    "jiti": "2.4.2",
    "liquidjs": "^10.24.0",
    "react": "^19.2.6",
    "remeda": "^2.33.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "//devDependencies": "The private @workspace packages are devDependencies so tsup bundles them (see noExternal); hono is omitted from dependencies so it is inlined too.",
  "devDependencies": {
    "@eslint/js": "^10",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@oclif/test": "^4.0.0",
    "@openai/codex": "0.155.1",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "@workspace/api": "workspace:*",
    "@workspace/api-mocks": "workspace:*",
    "@workspace/compile": "workspace:*",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/matrix": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@xterm/headless": "^6.0.0",
    "ansis": "^3.17.0",
    "esbuild": "^0.28.1",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "msw": "^2",
    "prettier": "^3.8.3",
    "tree-kill": "^1.2.2",
    "tsup": "^8.0.0",
    "typescript": "~6",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
