{
  "name": "agents-inc",
  "version": "0.151.0",
  "description": "CLI for managing Agents Inc. skills, stacks, and agents for Claude Code",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./config": {
      "import": "./dist/config-exports.js"
    }
  },
  "bin": {
    "agents-inc": "dist/index.js",
    "agentsinc": "dist/index.js"
  },
  "files": [
    "dist/",
    "assets/",
    "src/agents/",
    "src/schemas/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "cli",
    "claude",
    "claude-code",
    "skills",
    "composable skills",
    "agents",
    "stacks",
    "plugins",
    "ai",
    "anthropic",
    "developer-tools",
    "productivity",
    "prompt-engineering",
    "ai-tools"
  ],
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "oclif": {
    "bin": "agents-inc",
    "dirname": "agents-inc",
    "commands": {
      "strategy": "pattern",
      "target": "./dist/commands"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ],
    "hooks": {
      "init": [
        "./dist/hooks/init"
      ]
    },
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "agentsinc": "node dist/index.js",
    "agentsinc:dev": "bun src/cli/index.ts",
    "test": "vitest run",
    "pretest:e2e": "bun run build",
    "test:e2e": "vitest --config e2e/vitest.config.ts --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && echo '✓ No TypeScript errors'",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "generate:types": "bun scripts/generate-source-types.ts",
    "generate:schemas": "bun scripts/generate-json-schemas.ts",
    "generate:schemas:check": "bun run generate:schemas && git diff --exit-code src/schemas/",
    "generate:types:check": "bun run generate:types && git diff --exit-code src/cli/types/generated/",
    "prepublishOnly": "bun run format:check && bun run lint && bun run typecheck && bun run generate:schemas:check && bun run generate:types:check && bun run build && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agents-inc/agents-inc.git",
    "directory": "packages/cli"
  },
  "author": "Vincent Bollaert",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/agents-inc/agents-inc/issues"
  },
  "homepage": "https://github.com/agents-inc/agents-inc#readme",
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@oclif/core": "^4.0.0",
    "@oclif/plugin-autocomplete": "^3.0.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-not-found": "^3.0.0",
    "@oclif/plugin-warn-if-update-available": "^3.0.0",
    "@oclif/table": "^0.5.0",
    "execa": "^9.0.0",
    "fast-glob": "^3.3.0",
    "fs-extra": "^11.2.0",
    "giget": "^1.2.0",
    "gray-matter": "^4.0.3",
    "ink": "^7",
    "jiti": "2.4.2",
    "liquidjs": "^10.24.0",
    "react": "^19.2.6",
    "remeda": "^2.33.6",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@lydell/node-pty": "^1.2.0-beta.3",
    "@oclif/test": "^4.0.0",
    "@types/fs-extra": "^11.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "@xterm/headless": "^6.0.0",
    "eslint": "^10",
    "eslint-config-prettier": "^10",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.8.3",
    "tree-kill": "^1.2.2",
    "tsup": "^8.0.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "engines": {
    "node": ">=22"
  }
}
