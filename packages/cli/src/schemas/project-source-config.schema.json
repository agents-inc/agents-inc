{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/project-source-config.schema.json",
  "title": "Project Source Configuration",
  "description": "Schema for .agents-inc/config.ts marketplace source configuration files. Provider-neutral, with no <provider> segment: the fields describe the repository's own layout. A source repo still declaring .claude-src/config.ts is read there indefinitely.",
  "type": "object",
  "properties": {
    "marketplace": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "marketplaceName": {
      "type": "string"
    },
    "agentsSource": {
      "type": "string"
    },
    "branding": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "skillsDir": {
      "type": "string"
    },
    "agentsDir": {
      "type": "string"
    },
    "stacksFile": {
      "type": "string"
    },
    "categoriesFile": {
      "type": "string"
    },
    "rulesFile": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
