{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/project-config.schema.json",
  "title": "Project Configuration",
  "description": "Schema for .claude-src/config.yaml consumer project files (name, agents, stack, skills).",
  "$comment": "HAND-MAINTAINED. scripts/generate-json-schemas.ts does NOT emit this file (nor project-source-config.schema.json) — its SCHEMA_ENTRIES list has no entry for either, so `generate:schemas` only reformats them with prettier on its way past. Edit this file by hand and keep it prettier-clean, or `generate:schemas:check` fails on the reformat. Three vocabularies below are copied out of src/cli/types/generated/source-types.ts and drift silently, because no generator and no check re-derives any of them: the stack category enum is the CATEGORIES tuple, verbatim and in that tuple's order; the selectedDomains enum is the DOMAINS tuple; and the skill-id pattern's leading alternation is that same DOMAINS tuple, since a skill id is `<domain>-<category>-<name>`. Re-derive all three whenever a category or domain is added, renamed or removed — a missing domain silently rejects every skill id under it.",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(ai|api|cli|desktop|infra|meta|mobile|shared|web)-.+-.+$"
      }
    },
    "author": {
      "type": "string"
    },
    "installMode": {
      "type": "string",
      "enum": ["eject", "plugin"]
    },
    "selectedDomains": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ai", "api", "cli", "desktop", "infra", "meta", "mobile", "shared", "web"]
      }
    },
    "stack": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "enum": [
            "ai-infrastructure",
            "ai-observability",
            "ai-orchestration",
            "ai-patterns",
            "ai-provider",
            "api-analytics",
            "api-api",
            "api-auth",
            "api-baas",
            "api-caching",
            "api-cms",
            "api-commerce",
            "api-db-host",
            "api-document",
            "api-email",
            "api-graphql",
            "api-kv",
            "api-messaging",
            "api-observability",
            "api-orm",
            "api-performance",
            "api-queue",
            "api-search",
            "api-specs",
            "api-sql-engine",
            "api-vector-db",
            "cli-framework",
            "cli-prompts",
            "desktop-backend",
            "desktop-framework",
            "desktop-ipc",
            "desktop-mobile",
            "desktop-multiwindow",
            "desktop-packaging",
            "desktop-plugins",
            "desktop-security",
            "desktop-storage",
            "desktop-testing",
            "desktop-ui",
            "desktop-updates",
            "infra-ci-cd",
            "infra-config",
            "infra-containers",
            "infra-iac",
            "infra-platform",
            "meta-design",
            "meta-methodology",
            "meta-planning",
            "meta-reviewing",
            "mobile-animation",
            "mobile-background",
            "mobile-camera",
            "mobile-deep-linking",
            "mobile-deployment",
            "mobile-framework",
            "mobile-hardware",
            "mobile-navigation",
            "mobile-notifications",
            "mobile-performance",
            "mobile-security",
            "mobile-storage",
            "mobile-styling",
            "mobile-testing",
            "mobile-ui-components",
            "shared-lint",
            "shared-monorepo",
            "shared-security",
            "shared-task-runner",
            "shared-tooling",
            "web-3d",
            "web-accessibility",
            "web-animation",
            "web-client-state",
            "web-dataviz",
            "web-dnd",
            "web-docs",
            "web-e2e",
            "web-editor",
            "web-error-handling",
            "web-file-upload",
            "web-files",
            "web-form-library",
            "web-forms",
            "web-framework",
            "web-graphql-client",
            "web-i18n",
            "web-maps",
            "web-meta-framework",
            "web-mocking",
            "web-performance",
            "web-pwa",
            "web-realtime",
            "web-routing",
            "web-rpc",
            "web-server-state",
            "web-streaming",
            "web-styling",
            "web-testing",
            "web-tooling",
            "web-ui-components",
            "web-ui-kit",
            "web-utilities"
          ]
        },
        "additionalProperties": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^(ai|api|cli|desktop|infra|meta|mobile|shared|web)-.+-.+$"
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "preloaded": {
                      "type": "boolean"
                    },
                    "local": {
                      "type": "boolean"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": ["id"],
                  "additionalProperties": false
                }
              ]
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(ai|api|cli|desktop|infra|meta|mobile|shared|web)-.+-.+$"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "preloaded": {
                        "type": "boolean"
                      },
                      "local": {
                        "type": "boolean"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": ["id"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "source": {
      "type": "string"
    },
    "marketplace": {
      "type": "string"
    },
    "agentsSource": {
      "type": "string"
    }
  },
  "required": ["name", "agents", "skills", "installMode", "stack", "source"],
  "additionalProperties": false
}
