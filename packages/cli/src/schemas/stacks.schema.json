{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/stacks.schema.json",
  "title": "Stacks Configuration",
  "description": "Schema for config/stacks.ts defining agent groupings.",
  "type": "object",
  "properties": {
    "stacks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "agents": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "ai-infrastructure",
                  "ai-observability",
                  "ai-orchestration",
                  "ai-patterns",
                  "ai-provider",
                  "api-analytics",
                  "api-api",
                  "api-auth",
                  "api-baas",
                  "api-caching",
                  "api-cms",
                  "api-commerce",
                  "api-db-host",
                  "api-document",
                  "api-email",
                  "api-graphql",
                  "api-kv",
                  "api-messaging",
                  "api-observability",
                  "api-orm",
                  "api-performance",
                  "api-queue",
                  "api-search",
                  "api-specs",
                  "api-sql-engine",
                  "api-vector-db",
                  "cli-framework",
                  "cli-prompts",
                  "desktop-backend",
                  "desktop-framework",
                  "desktop-ipc",
                  "desktop-mobile",
                  "desktop-multiwindow",
                  "desktop-packaging",
                  "desktop-plugins",
                  "desktop-security",
                  "desktop-storage",
                  "desktop-testing",
                  "desktop-ui",
                  "desktop-updates",
                  "infra-ci-cd",
                  "infra-config",
                  "infra-containers",
                  "infra-iac",
                  "infra-platform",
                  "meta-design",
                  "meta-methodology",
                  "meta-planning",
                  "meta-reviewing",
                  "mobile-animation",
                  "mobile-background",
                  "mobile-camera",
                  "mobile-deep-linking",
                  "mobile-deployment",
                  "mobile-framework",
                  "mobile-hardware",
                  "mobile-navigation",
                  "mobile-notifications",
                  "mobile-performance",
                  "mobile-security",
                  "mobile-storage",
                  "mobile-styling",
                  "mobile-testing",
                  "mobile-ui-components",
                  "shared-lint",
                  "shared-monorepo",
                  "shared-security",
                  "shared-task-runner",
                  "shared-tooling",
                  "web-3d",
                  "web-accessibility",
                  "web-animation",
                  "web-client-state",
                  "web-dataviz",
                  "web-dnd",
                  "web-docs",
                  "web-e2e",
                  "web-editor",
                  "web-error-handling",
                  "web-file-upload",
                  "web-files",
                  "web-form-library",
                  "web-forms",
                  "web-framework",
                  "web-graphql-client",
                  "web-i18n",
                  "web-maps",
                  "web-meta-framework",
                  "web-mocking",
                  "web-performance",
                  "web-pwa",
                  "web-realtime",
                  "web-routing",
                  "web-rpc",
                  "web-server-state",
                  "web-streaming",
                  "web-styling",
                  "web-testing",
                  "web-tooling",
                  "web-ui-components",
                  "web-ui-kit",
                  "web-utilities"
                ]
              },
              "additionalProperties": {
                "anyOf": [
                  {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "preloaded": {
                            "type": "boolean"
                          },
                          "local": {
                            "type": "boolean"
                          },
                          "path": {
                            "type": "string"
                          }
                        },
                        "required": ["id"],
                        "additionalProperties": false
                      }
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "string"
                            },
                            "preloaded": {
                              "type": "boolean"
                            },
                            "local": {
                              "type": "boolean"
                            },
                            "path": {
                              "type": "string"
                            }
                          },
                          "required": ["id"],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                ]
              }
            }
          },
          "philosophy": {
            "type": "string"
          }
        },
        "required": ["id", "name", "description", "agents"],
        "additionalProperties": false
      }
    }
  },
  "required": ["stacks"],
  "additionalProperties": false
}
