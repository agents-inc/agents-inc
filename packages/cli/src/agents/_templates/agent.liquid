---
name: {{ agent.name }}
description: {{ agent.description | json }}
tools: {{ agent.tools | join: ", " }}
{% if agent.disallowedTools.size > 0 %}disallowedTools: {{ agent.disallowedTools | join: ", " }}
{% endif %}model: {{ agent.model | default: "inherit" }}
{% if agent.effort %}effort: {{ agent.effort }}
{% endif %}permissionMode: {{ agent.permissionMode | default: "default" }}
{% if agent.isolation %}isolation: {{ agent.isolation }}
{% endif %}{% if agent.experimental %}experimental: {{ agent.experimental | json }}
{% endif %}{% if agent.hooks %}hooks: {{ agent.hooks | json }}
{% endif %}{% if preloadedSkillIds.size > 0 %}skills:
{% for skillId in preloadedSkillIds %}  - {{ skillId }}
{% endfor %}{% endif %}---

# {{ agent.title }}

<role>
{{ identity }}
</role>

---

{% render "methodologies/operating-principles" %}

---

{% if criticalRequirementsTop != "" %}<critical_requirements>
{{ criticalRequirementsTop }}
</critical_requirements>

---

{% endif %}{{ playbook }}

---

{% if criticalReminders != "" %}<critical_reminders>
{{ criticalReminders }}
</critical_reminders>

---

{% endif %}{% if output != "" %}{{ output }}

---

{% endif %}<system-reminder>
Compiled by {{ generatorVersion }}.

{% if dynamicSkills.size > 0 %}<skill_activation_protocol>
The skills below are available through the Skill tool. Open a task by naming which of them it
touches and loading those first — a skill carries the conventions this project expects for its
area, and its content reaches you only once you invoke it.

{% for skill in dynamicSkills %}### {{ skill.id }}
- Description: {{ skill.description }}
- Invoke: `skill: "{{ skill.pluginRef | default: skill.id }}"`
- {{ skill.usage }}

{% endfor %}</skill_activation_protocol>
{% elsif preloadedSkillIds.size > 0 %}<skills_note>
This agent's skills are preloaded through its frontmatter, so their content is already in context.
</skills_note>
{% else %}<skills_note>
No skills are configured for this agent. The Skill tool is available, so a skill this project adds
later can be loaded by name.
</skills_note>
{% endif %}</system-reminder>
