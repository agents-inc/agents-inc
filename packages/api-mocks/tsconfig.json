{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // DOM for the Fetch API, which is the same in browser, Node and Workers.
    "lib": ["ES2022", "DOM"]
  },
  // In a tsconfig so type-aware ESLint can parse it.
  "include": ["src", "vitest.config.ts", "vitest.mutation.config.ts"],
  "exclude": ["node_modules"]
}
