{
  "name": "@workspace/matrix",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "//generate": "Delegates: packages/cli is the single writer of src/vendor/** and src/generated/**, and its scripts/generate-matrix-package.ts is what emits them. Kept as an entry point here because the files it writes carry a header telling the reader to run it from this package.",
  "scripts": {
    "generate": "cd ../cli && bun run generate:matrix",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "^10",
    "globals": "^17",
    "typescript": "~6",
    "vitest": "^4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./built-in-matrix": "./src/built-in-matrix.ts",
    "./matrix-schema": "./src/matrix-schema.ts",
    "./seed": "./src/seed.ts",
    "./skill-index": "./src/skill-index.ts"
  }
}
