{
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    "paths": {
      "@workspace/matrix": ["./src/index.ts"],
      "@workspace/matrix/*": ["./src/*"]
    }
  },
  // vitest.config.ts is listed so type-aware ESLint can parse it.
  "include": [
    "src",
    "scripts",
    "vitest.config.ts",
    "vitest.mutation.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
