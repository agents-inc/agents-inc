{
  "name": "@workspace/compile",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "//generate": "Delegates to packages/cli's generate-compile-package.ts, the single writer of src/generated/**.",
  "scripts": {
    "generate": "cd ../cli && bun run generate:compile",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@workspace/matrix": "workspace:*",
    "liquidjs": "^10.24.0",
    "remeda": "^2.33.6",
    "yaml": "^2.9.0"
  },
  "//smol-toml": "A devDependency: only the spec parses TOML, to hold the hand-written role files against a real parser.",
  "devDependencies": {
    "@types/node": "^24",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "eslint": "^10",
    "globals": "^17",
    "smol-toml": "^1.7.1",
    "typescript": "~6",
    "vitest": "^4"
  },
  "exports": {
    ".": "./src/index.ts",
    "./paths": "./src/paths.ts",
    "./config-source": "./src/config-source.ts",
    "./config-types-source": "./src/config-types-source.ts",
    "./agent-source": "./src/agent-source.ts",
    "./engine": "./src/engine.ts",
    "./seed-to-config": "./src/seed-to-config.ts",
    "./global-config": "./src/global-config.ts",
    "./carried-skill": "./src/carried-skill.ts",
    "./corpus": "./src/generated/corpus.ts",
    "./preview": "./src/preview.ts"
  }
}
