{
  "name": "@workspace/ui",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "//no-shared-vitest-config": "Partial: `storybook` is standalone because the shared config is DOM-free, while `unit` extends it.",
  "//chromatic": "Chromatic diffs every story's appearance in both themes, and `autoAcceptChanges` stays unset because this repository commits straight to main, so it would accept every diff.",
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic",
    "test": "bun scripts/check-token-parity.ts && vitest run",
    "tokens": "tz build && bun scripts/hexify-tokens.ts",
    "//tokens": "Emits src/styles/tokens.css from tokens/tokens.json; nothing checks the output is current, so rerun it after editing the JSON.",
    "tokens:check": "bun scripts/check-token-parity.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.15.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10",
    "@storybook/addon-vitest": "^10",
    "@storybook/react-vite": "^10",
    "@tailwindcss/vite": "^4",
    "@terrazzo/cli": "^2.7.1",
    "@terrazzo/plugin-css": "^2.7.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^4",
    "@vitest/browser-playwright": "^4",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/prettier-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "@workspace/vitest-config": "workspace:*",
    "chromatic": "^18",
    "eslint": "^10",
    "playwright": "1.63.0",
    "storybook": "^10",
    "tailwindcss": "^4",
    "typescript": "~6",
    "vite": "^8",
    "vitest": "^4"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx"
  }
}
