# Gates a push by side: the whole CLI side and/or the whole web side, whichever moved.
# Cheapest first: deps:check, then lint per side, then each side's unit and e2e suites.
# The web suites need chromium: `bunx playwright install --with-deps chromium`.

# No upstream (new branch, detached HEAD) means no range, so both sides run.
# --no-renames splits a move into both of its paths. Every grep sits inside an `if`
# because husky runs this with `sh -e`.
run_cli=no
run_web=no
run_deps=no

if git rev-parse --verify --quiet '@{push}' >/dev/null 2>&1; then
	pushed=$(git diff --name-only --no-renames '@{push}..HEAD')
else
	pushed=
	run_cli=yes
	run_web=yes
	run_deps=yes
fi

if printf '%s\n' "$pushed" | grep -q '^packages/cli/'; then
	run_cli=yes
fi

# The CLI bundles these, and the web filter below excludes the CLI.
if printf '%s\n' "$pushed" | grep -qE '^packages/(matrix|compile|api|api-mocks)/'; then
	run_cli=yes
fi

# The second grep drops the CLI's own paths.
if printf '%s\n' "$pushed" | grep -E '^(apps|packages)/' | grep -qv '^packages/cli/'; then
	run_web=yes
fi

# Root tooling changes how both sides install, build and run.
if printf '%s\n' "$pushed" | grep -qE '^(package\.json|bun\.lock|turbo\.json|tsconfig\.json)$|^(\.husky|\.github)/'; then
	run_cli=yes
	run_web=yes
fi

# The cross-workspace checks read these files wherever they sit, so it is unanchored.
if printf '%s\n' "$pushed" | grep -qE '(^|/)(package\.json|bun\.lock|tsconfig[^/]*\.json|vitest\.config\.[^/]+|eslint\.config\.[^/]+|[^/]+\.test\.tsx?)$'; then
	run_deps=yes
fi

if [ "$run_deps" = yes ]; then
	bun run deps:check
fi

if [ "$run_cli" = yes ]; then
	bunx turbo run lint --filter=agents-inc
fi

if [ "$run_web" = yes ]; then
	bunx turbo run lint --filter='!agents-inc'
fi

# Each suite is its own turbo invocation: run concurrently they flake red under CPU
# contention. `sh -e` stops e2e when the unit suite fails.
if [ "$run_cli" = yes ]; then
	bunx turbo run test --filter=agents-inc
	bunx turbo run test:e2e --filter=agents-inc
fi

if [ "$run_web" = yes ]; then
	bunx turbo run test --filter='!agents-inc'
	bunx turbo run test:e2e --filter='!agents-inc'
fi
