# Lint and format staged files; see //lint-staged in the root package.json.
bunx lint-staged

staged=$(git diff --cached --name-only --no-renames)

# These files feed the cross-workspace checks wherever they sit. The grep sits inside
# an `if` because husky runs this with `sh -e`.
run_deps=no

if printf '%s\n' "$staged" | grep -qE '(^|/)(package\.json|bun\.lock|tsconfig[^/]*\.json|vitest\.config\.[^/]+|eslint\.config\.[^/]+)$'; then
	run_deps=yes
fi

if [ "$run_deps" = yes ]; then
	bun run deps:check
fi

# Two tiers: this runs lint, typecheck and unit tests for `...[HEAD]` (changed
# packages, staged or not, plus dependents); pre-push runs each side in full with e2e.
# ESLint repeats here because type-aware rules can report in files not staged.
bunx turbo run lint typecheck test --filter='...[HEAD]'

# Catches a schema edit committed without its migration.
bunx turbo run db:generate:check --filter='...[HEAD]'
